# Copy this file to `.env` and fill in the keys you have.
# The app runs end-to-end even with NO keys (llm_provider=mock, web_search_provider=mock).

# ---------- LLM provider ----------
# One of: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_TEMPERATURE=0.2

# ---------- Web search provider (mandatory tool) ----------
# One of: mock | serper | exa
WEB_SEARCH_PROVIDER=mock
SERPER_API_KEY=
EXA_API_KEY=

# ---------- Weather (free, no key: Open-Meteo) ----------
# One of: openmeteo | mock
WEATHER_PROVIDER=openmeteo

# ---------- App ----------
STORAGE_DIR=storage
# DATABASE_PATH=storage/planner.sqlite
REQUEST_TIMEOUT_SECONDS=60
MAX_REVISIONS=3